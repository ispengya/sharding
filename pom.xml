<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.ispengya</groupId>
    <artifactId>sharding-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>sharding-parent</name>
    <description>基于 Spring Boot + MyBatis 的分库分表中间件（多模块）：sharding-core 为零 Spring Boot 依赖的核心，boot2 / boot3 starter 分别面向 Spring Boot 2.x 与 3.x 应用，一套核心支持两条装配线。</description>
    <url>https://github.com/ispengya/sharding</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ispengya</id>
            <name>ispengya</name>
            <email>ispengya@gmail.com</email>
            <url>https://github.com/ispengya</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ispengya/sharding.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ispengya/sharding.git</developerConnection>
        <url>https://github.com/ispengya/sharding</url>
    </scm>

    <!-- GPG 签名参数不写入 POM：发布时经命令行 -Dgpg.keyname / -Dgpg.passphrase.file 提供，见 RELEASING.md -->

    <modules>
        <module>sharding-core</module>
        <module>sharding-boot2-starter</module>
        <module>sharding-boot3-starter</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 编译基线：core 与 boot2 为 Java 8 字节码（javac8/javac17 皆可编译）；boot3 模块自行 override 为 17 -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- javadoc 的 release 参数与编译基线一致（发布构建在 JDK 17 上执行）；boot3 override 为 17 -->
        <javadoc.release>8</javadoc.release>

        <!-- 测试（Boot BOM 不管理的共用项） -->
        <mysql.version>8.0.29</mysql.version>
        <hdrhistogram.version>2.1.12</hdrhistogram.version>
        <!-- starter 装配线 -->
        <lombok.version>1.18.30</lombok.version>
        <boot2.version>2.1.3.RELEASE</boot2.version>
        <mybatis-boot2-starter.version>2.2.0</mybatis-boot2-starter.version>
        <boot3.version>3.3.2</boot3.version>
        <mybatis-boot3-starter.version>3.0.3</mybatis-boot3-starter.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>io.github.ispengya</groupId>
                <artifactId>sharding-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 测试（Boot BOM 不管理，两代 starter 的 test 共用） -->
            <dependency>
                <groupId>org.hdrhistogram</groupId>
                <artifactId>HdrHistogram</artifactId>
                <version>${hdrhistogram.version}</version>
            </dependency>
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <!-- 注意：core 的 Spring/MyBatis/日志等版本管理在各模块自身 pom 显式声明，
                 避免根级管理覆盖 starter 各自 Boot BOM 的版本线（如 Boot 3 的 logback 1.5 / Spring 6） -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.10.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.7</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.9.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <!-- 与各模块编译基线一致：core/boot2 为 8，boot3-starter override 为 17 -->
                            <release>${javadoc.release}</release>
                            <doclint>none</doclint>
                            <charset>UTF-8</charset>
                            <docencoding>UTF-8</docencoding>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <keyname>${gpg.keyname}</keyname>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--passphrase-file</arg>
                                <arg>${gpg.passphrase.file}</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
